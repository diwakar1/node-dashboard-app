FROM node:20-alpine
WORKDIR /workspace

# ── Build shared TypeScript package ──────────────────────────────────────────
COPY shared/package.json shared/tsconfig.json ./shared/
COPY shared/src ./shared/src/
RUN cd shared && npm install && npm run build

# ── Install frontend dependencies ─────────────────────────────────────────────
COPY frontend/package.json ./frontend/
RUN cd frontend && npm install

WORKDIR /workspace/frontend

# Source code is bind-mounted at runtime by docker-compose (./frontend).
# node_modules is preserved by a separate named volume.
EXPOSE 3000
# BACKEND_URL env var is injected by docker-compose so the Vite proxy
# can reach the backend container (e.g. http://backend:5000).
CMD ["npx", "vite", "--host", "0.0.0.0"]
